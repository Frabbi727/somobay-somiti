APP_NAME="Somiti Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=somiti
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SMS_DRIVER=log
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# Backups: comma-separated disks (add an off-site disk in production) and who is alerted
BACKUP_DISKS=backups
# Every backup zip is AES-256 encrypted with this password (at least 16 characters). Keep a copy
# outside the server — without it the backups cannot be opened.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=
# Off-site copy: set the bucket below and change BACKUP_DISKS to backups,offsite
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

# Subjects whose approval needs a passed resolution linked (comma-separated), e.g. rate_plan
SOMITI_REQUIRE_RESOLUTION_FOR=
# Quorum in basis points of those eligible (5000 = half). Set from your bylaws.
SOMITI_QUORUM_COMMITTEE_BPS=5001
SOMITI_QUORUM_GENERAL_BPS=3334
SOMITI_QUORUM_SPECIAL_GENERAL_BPS=3334

# Year-end (s.34): set from your bylaws with your auditor
SOMITI_FINANCING_SOCIETY=false
SOMITI_STATUTORY_BASE=net_profit

# Member portal sign-in by SMS code (needs an SMS gateway). false = mobile + password only;
# the secretary sets each member's password from the member page.
SOMITI_PORTAL_OTP=false
